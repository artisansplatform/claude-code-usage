#!/usr/bin/env python3
"""Claude Code usage collector (stdlib only).

Reads local Claude Code data (~/.claude) and emits deterministic metrics for the
usage-report / usage-pulse skills. Never sends anything anywhere; all outputs are
local files. Transcript JSONL is an internal, unstable format, so every parse
here is defensive: unknown record types and malformed lines are skipped.

Outputs (in --out dir):
  metrics.json         aggregate numbers only (safe to build a shared report from)
  sessions.jsonl       compact per-session rows, LOCAL ONLY (contains prompt/summary text)
  prompt_sample.jsonl  stratified sample of prompts for quality scoring, LOCAL ONLY
"""

import argparse
import json
import os
import re
import statistics
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude")))
IDLE_GAP_MIN = 30          # gaps longer than this don't count as active time
FIRST_PROMPT_CHARS = 240
SAMPLE_PROMPT_CHARS = 600
META_MARKERS = ("<command-name>", "<local-command-stdout>", "[Request interrupted",
                "<system-reminder>", "Caveat: The messages below")
DELEGATION_TOOLS = {"Task", "Agent", "Workflow"}
PLAN_TOOLS = {"ExitPlanMode", "EnterPlanMode", "exit_plan_mode"}

# Best-effort masking of credential-shaped strings before prompt text is stored
# for LLM scoring. Defense in depth: the files stay local either way.
REDACTIONS = [
    (re.compile(r"eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_.-]{10,}"), "[JWT]"),
    (re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\b"), "[GH-TOKEN]"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"), "[GH-TOKEN]"),
    (re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"), "[API-KEY]"),
    (re.compile(r"\bAKIA[A-Z0-9]{16}\b"), "[AWS-KEY]"),
    (re.compile(r"(?i)\b(token|secret|password|passwd|api[_-]?key)\b(\s*[=:]\s*)\S+"),
     r"\1\2[REDACTED]"),
    (re.compile(r"\b[A-Z0-9]{25,}\b"), "[TOKEN?]"),
    (re.compile(r"\b[A-Fa-f0-9]{32,}\b"), "[HEX]"),
    (re.compile(r"\b[A-Za-z0-9+/=]{60,}\b"), "[B64]"),
]


# Broad patterns (last three) catch git SHAs, base64 blobs etc. Fine for
# masking prompt text, far too noisy for COUNTING credentials in shell
# commands, so the Bash counter uses only the high-precision ones.
HIGH_PRECISION_REDACTIONS = REDACTIONS[:-3]


def redact(text, patterns=REDACTIONS):
    n = 0
    for pat, repl in patterns:
        text, k = pat.subn(repl, text)
        n += k
    return text, n


def parse_iso(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except Exception:
        return None


def local(dt):
    return dt.astimezone() if dt else None


def read_jsonl(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except Exception:
                    continue
    except OSError:
        return


def text_of_user_message(msg):
    """Extract typed text from a user record's message; '' if it is tool_result/meta."""
    content = (msg or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text"]
        return "\n".join(p for p in parts if p)
    return ""


def is_meta_text(txt):
    return any(m in txt for m in META_MARKERS)


# ---------------------------------------------------------------- history.jsonl

def collect_history(frm, to):
    """Prompt rhythm from history.jsonl (covers all projects, survives cleanup)."""
    rows = []
    for rec in read_jsonl(CLAUDE_HOME / "history.jsonl"):
        ts = rec.get("timestamp")
        try:
            dt = datetime.fromtimestamp(int(ts) / 1000, tz=timezone.utc)
        except Exception:
            continue
        ldt = local(dt)
        if not (frm <= ldt <= to):
            continue
        rows.append({
            "dt": ldt,
            "project": rec.get("project") or "?",
            "text": (rec.get("display") or "").strip(),
            "session": rec.get("sessionId") or "",
        })
    return rows


# ---------------------------------------------------------------- transcripts

def parse_session(path, frm, to, seen_msgs, seen_prompts):
    """seen_msgs / seen_prompts dedupe across files: a resumed session copies
    prior records into a new .jsonl, so per-file counting double-counts."""
    first_ts = last_ts = None
    ts_points = []
    prompts = 0
    first_prompt = None
    models = Counter()
    tools = Counter()
    tool_errors = 0
    interruptions = 0
    sidechain_records = 0
    usage_by_msg = {}
    cwd = None
    git_branch = None
    version = None
    permission_mode = None
    sandbox_disables = 0
    bash_cred_hits = 0

    for rec in read_jsonl(path):
        rtype = rec.get("type")
        ts = parse_iso(rec.get("timestamp", "")) if rec.get("timestamp") else None
        if ts:
            ldt = local(ts)
            ts_points.append(ldt)
            first_ts = min(first_ts, ldt) if first_ts else ldt
            last_ts = max(last_ts, ldt) if last_ts else ldt
        if rec.get("isSidechain"):
            sidechain_records += 1
            continue
        cwd = rec.get("cwd") or cwd
        git_branch = rec.get("gitBranch") or git_branch
        version = rec.get("version") or version
        if rtype == "permission-mode":
            permission_mode = rec.get("permissionMode") or permission_mode
        msg = rec.get("message") or {}

        if rtype == "assistant":
            model = msg.get("model")
            if model and model != "<synthetic>":
                models[model] += 1
                mid = msg.get("id") or rec.get("requestId") or rec.get("uuid")
                usage = msg.get("usage")
                if mid and isinstance(usage, dict):
                    usage_by_msg[mid] = (model, usage)  # last snapshot per message wins
            for block in msg.get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    name = block.get("name") or "?"
                    tools[name] += 1
                    tin = block.get("input") or {}
                    if name == "Bash" and isinstance(tin, dict):
                        if tin.get("dangerouslyDisableSandbox"):
                            sandbox_disables += 1
                        cmd = tin.get("command")
                        if isinstance(cmd, str) and \
                                redact(cmd, HIGH_PRECISION_REDACTIONS)[1]:
                            bash_cred_hits += 1
        elif rtype == "user":
            content = msg.get("content")
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_result" \
                            and block.get("is_error"):
                        tool_errors += 1
            txt = text_of_user_message(msg)
            if not txt:
                continue
            if "[Request interrupted" in txt:
                interruptions += 1
                continue
            if rec.get("isMeta") or is_meta_text(txt):
                continue
            ruid = rec.get("uuid")
            if ruid and ruid in seen_prompts:
                continue
            if ruid:
                seen_prompts.add(ruid)
            prompts += 1
            if first_prompt is None:
                first_prompt = redact(txt[:FIRST_PROMPT_CHARS])[0]

    if not first_ts or last_ts < frm or first_ts > to:
        return None

    ts_points.sort()
    active_min = 0.0
    for a, b in zip(ts_points, ts_points[1:]):
        gap = (b - a).total_seconds() / 60
        if 0 <= gap <= IDLE_GAP_MIN:
            active_min += gap

    tokens_by_model = defaultdict(lambda: {"input": 0, "output": 0,
                                           "cache_read": 0, "cache_creation": 0})
    for mid in list(usage_by_msg):
        if mid in seen_msgs:
            del usage_by_msg[mid]
        else:
            seen_msgs.add(mid)
    for model, usage in usage_by_msg.values():
        t = tokens_by_model[model]
        t["input"] += usage.get("input_tokens") or 0
        t["output"] += usage.get("output_tokens") or 0
        t["cache_read"] += usage.get("cache_read_input_tokens") or 0
        t["cache_creation"] += usage.get("cache_creation_input_tokens") or 0

    return {
        "id": path.stem,
        "project": cwd or path.parent.name,
        "start": first_ts.isoformat(),
        "date": first_ts.date().isoformat(),
        "wall_min": round((last_ts - first_ts).total_seconds() / 60, 1),
        "active_min": round(active_min, 1),
        "prompts": prompts,
        "first_prompt": first_prompt or "",
        "models": dict(models),
        "tools": dict(tools),
        "tool_errors": tool_errors,
        "interruptions": interruptions,
        "delegation_calls": sum(n for t, n in tools.items()
                                if t in DELEGATION_TOOLS) + (1 if sidechain_records else 0),
        "plan_mode": any(t in PLAN_TOOLS for t in tools),
        "tokens_by_model": {m: dict(t) for m, t in tokens_by_model.items()},
        "git_branch": git_branch,
        "cc_version": version,
        "permission_mode": permission_mode,
        "sandbox_disables": sandbox_disables,
        "bash_cred_hits": bash_cred_hits,
    }


def collect_sessions(frm, to):
    rows = []
    proj_root = CLAUDE_HOME / "projects"
    if not proj_root.is_dir():
        return rows
    cutoff = (frm - timedelta(days=1)).timestamp()
    seen_msgs, seen_prompts = set(), set()
    # oldest first so a resume's duplicated records attribute to the original
    for path in sorted(proj_root.glob("*/*.jsonl"),
                       key=lambda p: p.stat().st_mtime if p.exists() else 0):
        try:
            if path.stat().st_mtime < cutoff:
                continue
        except OSError:
            continue
        row = parse_session(path, frm, to, seen_msgs, seen_prompts)
        if row:
            rows.append(row)
    return rows


# ------------------------------------------------------- insights caches (optional)

def load_cache_dir(name):
    out = {}
    d = CLAUDE_HOME / "usage-data" / name
    if not d.is_dir():
        return out
    for f in d.glob("*.json"):
        try:
            data = json.loads(f.read_text(encoding="utf-8", errors="replace"))
        except Exception:
            continue
        sid = data.get("session_id") or f.stem
        out[sid] = data
    return out


# ---------------------------------------------------------------- foundation scan

def count_dir(p, pattern="*"):
    try:
        return len(list(Path(p).glob(pattern)))
    except OSError:
        return 0


def hooks_count(settings_path):
    try:
        data = json.loads(Path(settings_path).read_text())
        hooks = data.get("hooks") or {}
        return sum(len(v) if isinstance(v, list) else 1 for v in hooks.values())
    except Exception:
        return 0


def foundation_scan(project_paths):
    per_project = {}
    for cwd in sorted(project_paths):
        p = Path(cwd)
        if not p.is_dir():
            continue
        claude_md = p / "CLAUDE.md"
        per_project[cwd] = {
            "claude_md_lines": len(claude_md.read_text(errors="replace").splitlines())
            if claude_md.is_file() else 0,
            "claude_md_mtime": datetime.fromtimestamp(claude_md.stat().st_mtime)
            .date().isoformat() if claude_md.is_file() else None,
            "skills": count_dir(p / ".claude" / "skills"),
            "commands": count_dir(p / ".claude" / "commands", "*.md"),
            "hooks": hooks_count(p / ".claude" / "settings.json"),
        }
    mem_files = 0
    for d in (CLAUDE_HOME / "projects").glob("*/memory"):
        mem_files += count_dir(d, "*.md")
    return {
        "projects": per_project,
        "global_skills": count_dir(CLAUDE_HOME / "skills"),
        "global_hooks": hooks_count(CLAUDE_HOME / "settings.json"),
        "plugins": count_dir(CLAUDE_HOME / "plugins" / "marketplaces"),
        "memory_files": mem_files,
    }


# ---------------------------------------------------------------- security posture

def _mcp_entry(cfg):
    """Provenance only: server type plus binary/host, never args or env."""
    if not isinstance(cfg, dict):
        return "?"
    if cfg.get("url"):
        host = re.sub(r"^\w+://", "", str(cfg["url"])).split("/")[0]
        return f"{cfg.get('type', 'http')}:{host}"
    cmd = str(cfg.get("command", "?")).split("/")[-1]
    return f"stdio:{cmd}"


def security_scan(sessions, project_paths):
    modes = Counter((s.get("permission_mode") or "default") for s in sessions)
    mcp = {}
    try:
        top = json.loads((Path.home() / ".claude.json").read_text())
        for name, cfg in (top.get("mcpServers") or {}).items():
            mcp[f"global:{name}"] = _mcp_entry(cfg)
        for proj, pcfg in (top.get("projects") or {}).items():
            if proj in project_paths:
                for name, cfg in (pcfg.get("mcpServers") or {}).items():
                    mcp[f"{Path(proj).name}:{name}"] = _mcp_entry(cfg)
    except Exception:
        pass
    for cwd in project_paths:
        f = Path(cwd) / ".mcp.json"
        try:
            for name, cfg in (json.loads(f.read_text()).get("mcpServers") or {}).items():
                mcp[f"{Path(cwd).name}:{name}"] = _mcp_entry(cfg)
        except Exception:
            continue
    marketplaces = {}
    try:
        km = json.loads((CLAUDE_HOME / "plugins" / "known_marketplaces.json").read_text())
        for name, cfg in (km.items() if isinstance(km, dict) else []):
            src = cfg.get("source") if isinstance(cfg, dict) else cfg
            marketplaces[name] = src if isinstance(src, str) else json.dumps(src)
    except Exception:
        pass
    skills = sorted(p.name for p in (CLAUDE_HOME / "skills").glob("*") if p.is_dir())
    for cwd in project_paths:
        skills += [f"{Path(cwd).name}:{p.name}"
                   for p in (Path(cwd) / ".claude" / "skills").glob("*") if p.is_dir()]
    cleanup_days = None
    try:
        cleanup_days = json.loads((CLAUDE_HOME / "settings.json").read_text()) \
            .get("cleanupPeriodDays")
    except Exception:
        pass
    return {
        "permission_modes_by_session": dict(modes),
        "bypass_permissions_sessions": modes.get("bypassPermissions", 0),
        "sandbox_disabled_bash_calls": sum(s.get("sandbox_disables", 0) for s in sessions),
        "bash_commands_with_credential_shapes": sum(s.get("bash_cred_hits", 0)
                                                    for s in sessions),
        "cc_versions_in_window": sorted({s["cc_version"] for s in sessions
                                         if s.get("cc_version")}),
        "mcp_servers": mcp,
        "marketplaces": marketplaces,
        "skills_installed": sorted(set(skills)),
        "cleanup_period_days": cleanup_days,
        "data_retention_attestation": None,
        "note": "attestation is filled by the skill after asking the member; "
                "the training/retention toggle is account-side and not readable locally",
    }


# ---------------------------------------------------------------- main

def member_name():
    try:
        out = subprocess.run(["git", "config", "--global", "user.name"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return os.environ.get("USER") or "unknown"


def substantive(txt):
    return len(txt) >= 20 and not txt.startswith("/") and not is_meta_text(txt)


def stratified_sample(prompts, cap):
    """Spread the sample across the window so early and late month both count."""
    if len(prompts) <= cap:
        return prompts
    prompts = sorted(prompts, key=lambda r: r["dt"])
    step = len(prompts) / cap
    return [prompts[int(i * step)] for i in range(cap)]


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--from", dest="frm", required=True, help="YYYY-MM-DD inclusive")
    ap.add_argument("--to", dest="to", required=True, help="YYYY-MM-DD inclusive")
    ap.add_argument("--out", required=True, help="output directory")
    ap.add_argument("--sample", type=int, default=60, help="max prompts to sample")
    args = ap.parse_args()

    frm = datetime.fromisoformat(args.frm).astimezone()
    to = datetime.fromisoformat(args.to).astimezone() + timedelta(days=1, seconds=-1)
    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)

    hist = collect_history(frm, to)
    sessions = collect_sessions(frm, to)
    facets = load_cache_dir("facets")
    session_meta = load_cache_dir("session-meta")

    # rhythm from history.jsonl
    by_day = Counter(r["dt"].date().isoformat() for r in hist)
    by_hour = Counter(r["dt"].hour for r in hist)
    by_weekday = Counter(r["dt"].strftime("%A") for r in hist)
    by_project = Counter(Path(r["project"]).name for r in hist)
    slash = Counter(r["text"].split()[0] for r in hist
                    if r["text"].startswith("/") and r["text"].split())
    active_days = sorted(by_day)
    counts = [by_day[d] for d in active_days]
    p75 = statistics.quantiles(counts, n=4)[2] if len(counts) >= 4 else None
    p25 = statistics.quantiles(counts, n=4)[0] if len(counts) >= 4 else None
    workdays = sum(1 for i in range((to.date() - frm.date()).days + 1)
                   if (frm.date() + timedelta(days=i)).weekday() < 5)
    active_workdays = sum(1 for d in active_days
                          if datetime.fromisoformat(d).weekday() < 5)
    active_weekend_days = len(active_days) - active_workdays

    # session aggregates + cache joins
    tools_total = Counter()
    model_tokens = defaultdict(lambda: Counter())
    outcomes, categories, frictions, satisfaction, helpfulness = (
        Counter(), Counter(), Counter(), Counter(), Counter())
    git_commits = git_pushes = meta_interruptions = 0
    response_time_medians = []
    facet_hits = meta_hits = 0
    for s in sessions:
        tools_total.update(s["tools"])
        for model, toks in s["tokens_by_model"].items():
            for k, v in toks.items():
                model_tokens[model][k] += v
        f = facets.get(s["id"])
        if f:
            facet_hits += 1
            s["facet"] = {k: f.get(k) for k in
                          ("goal_categories", "outcome", "friction_counts",
                           "session_type", "primary_success", "brief_summary")}
            outcomes[f.get("outcome") or "?"] += 1
            for c, n in (f.get("goal_categories") or {}).items():
                categories[c] += n
            for c, n in (f.get("friction_counts") or {}).items():
                frictions[c] += n
            for c, n in (f.get("user_satisfaction_counts") or {}).items():
                satisfaction[c] += n
            helpfulness[f.get("claude_helpfulness") or "?"] += 1
        m = session_meta.get(s["id"])
        if m:
            meta_hits += 1
            git_commits += m.get("git_commits") or 0
            git_pushes += m.get("git_pushes") or 0
            meta_interruptions += m.get("user_interruptions") or 0
            rts = m.get("user_response_times") or []
            if rts:
                response_time_medians.append(statistics.median(rts))

    metrics = {
        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "member": member_name(),
        "window": {"from": args.frm, "to": args.to, "workdays_mon_fri": workdays},
        "collector_version": "0.1.0",
        "definitions": {
            "active_day": "calendar day (local time) with >=1 typed prompt (history.jsonl)",
            "usage_pct": "active Mon-Fri days / Mon-Fri workdays in window; weekend days reported separately",
            "heavy_day": "prompts >= P75 of active days (needs >=4 active days)",
            "light_day": "prompts <= P25 of active days",
            "active_min": "assistant-active time: gaps <=30min between transcript events; includes unattended/overnight runs, so it is NOT person-hours",
            "tokens": "deduplicated per API message id, attributed to that message's model; estimates, not billing data",
        },
        "rhythm": {
            "prompts_total": len(hist),
            "active_days": len(active_days),
            "active_workdays": active_workdays,
            "active_weekend_days": active_weekend_days,
            "usage_pct": round(100 * active_workdays / workdays, 1) if workdays else None,
            "prompts_by_day": dict(sorted(by_day.items())),
            "by_hour_local": {str(h): by_hour[h] for h in sorted(by_hour)},
            "by_weekday": dict(by_weekday),
            "per_project": dict(by_project.most_common()),
            "heavy_days": sum(1 for c in counts if p75 and c >= p75),
            "light_days": sum(1 for c in counts if p25 and c <= p25),
            "p75_threshold": p75, "p25_threshold": p25,
            "slash_commands": dict(slash.most_common(20)),
        },
        "sessions": {
            "count": len(sessions),
            "active_minutes_total": round(sum(s["active_min"] for s in sessions), 1),
            "wall_minutes_total": round(sum(s["wall_min"] for s in sessions), 1),
            "prompts_in_sessions": sum(s["prompts"] for s in sessions),
            "interruptions": sum(s["interruptions"] for s in sessions),
            "tool_errors": sum(s["tool_errors"] for s in sessions),
            "tool_calls_total": sum(tools_total.values()),
            "tools_top": dict(tools_total.most_common(15)),
            "plan_mode_sessions": sum(1 for s in sessions if s["plan_mode"]),
            "delegation_sessions": sum(1 for s in sessions if s["delegation_calls"]),
            "distinct_projects": len({s["project"] for s in sessions}),
            "model_tokens": {m: dict(c) for m, c in model_tokens.items()},
        },
        "insights_cache": {
            "facet_coverage": f"{facet_hits}/{len(sessions)}",
            "meta_coverage": f"{meta_hits}/{len(sessions)}",
            "outcomes": dict(outcomes),
            "goal_categories": dict(categories.most_common()),
            "frictions": dict(frictions.most_common()),
            "satisfaction": dict(satisfaction),
            "helpfulness": dict(helpfulness),
            "git_commits": git_commits,
            "git_pushes": git_pushes,
            "meta_interruptions": meta_interruptions,
            "median_response_time_s": round(statistics.median(response_time_medians), 1)
            if response_time_medians else None,
        },
        "foundation": foundation_scan({s["project"] for s in sessions}),
        "security": security_scan(sessions, {s["project"] for s in sessions}),
    }

    with open(out / "sessions.jsonl", "w") as fh:
        fh.write(json.dumps({"_notice": "LOCAL ONLY. Contains work content. Never share."}) + "\n")
        for s in sorted(sessions, key=lambda r: r["start"]):
            slim = {k: s[k] for k in ("id", "project", "date", "active_min", "prompts",
                                      "first_prompt", "tool_errors", "interruptions")}
            slim["top_tools"] = Counter(s["tools"]).most_common(5)
            slim["facet"] = s.get("facet")
            fh.write(json.dumps(slim) + "\n")

    pool = [r for r in hist if substantive(r["text"])]
    sample = stratified_sample(pool, args.sample)
    secret_pastes = 0
    with open(out / "prompt_sample.jsonl", "w") as fh:
        fh.write(json.dumps({"_notice": "LOCAL ONLY. Contains work content "
                             "(credential-shaped strings auto-masked, best effort). Never share."}) + "\n")
        for r in sample:
            text, hits = redact(r["text"][:SAMPLE_PROMPT_CHARS])
            secret_pastes += 1 if hits else 0
            fh.write(json.dumps({
                "ts": r["dt"].isoformat(timespec="minutes"),
                "project": Path(r["project"]).name,
                "brief": len(r["text"]) >= 200,
                "text": text,
            }) + "\n")
    metrics["hygiene"] = {
        "sampled_prompts_with_credential_shapes": secret_pastes,
        "note": "count of sampled prompts where masking fired; if > 0 the report "
                "suggests env vars / files as the easier alternative",
    }
    (out / "metrics.json").write_text(json.dumps(metrics, indent=1))

    print(f"ccur-collect: {len(hist)} prompts / {len(active_days)} active days / "
          f"{len(sessions)} sessions ({facet_hits} with facets) -> {out}")
    print(f"sampled {len(sample)} of {len(pool)} substantive prompts for scoring")


if __name__ == "__main__":
    sys.exit(main())
